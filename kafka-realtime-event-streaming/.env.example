# ==============================================================================
# Apache Kafka & Cloud Instance Configuration
# ==============================================================================
# Kafka Broker bootstrap servers (comma-separated if multiple)
# For local Docker / Localhost: localhost:9092
# For AWS EC2 instance: <EC2_PUBLIC_IP_OR_DNS>:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Default Kafka Topics
KAFKA_TOPIC_IOT=iot-fleet-telemetry
KAFKA_TOPIC_FINANCE=financial-transactions
KAFKA_TOPIC_CLICKSTREAM=ecommerce-clicks

# Streaming Generator Settings
STREAM_EVENT_RATE_PER_SEC=5
STREAM_TOTAL_EVENTS=0
STREAM_ANOMALY_PERCENTAGE=5

# Kafka Client Identification
KAFKA_CLIENT_ID=cloud-streaming-producer-01
KAFKA_CONSUMER_GROUP=cloud-stream-analytics-group
