# ==============================================================================
# Snowflake Data Cloud Configuration
# ==============================================================================
# Snowflake Account Identifier (e.g. xy12345.eu-north-1 or org-account)
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier

# Authentication
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Target Compute & Hierarchy
SNOWFLAKE_WAREHOUSE=STREAMING_WH
SNOWFLAKE_DATABASE=STREAMING_ANALYTICS_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Streaming Ingestion Settings
STREAM_BATCH_SIZE=10
STREAM_INTERVAL_SECONDS=1.0
STREAM_ANOMALY_RATE=10
