# AWS Cloud Configuration
AWS_REGION=eu-north-1
AWS_S3_BUCKET=spark-etl-pipeline-assignment2-dhruv
AWS_S3_RAW_KEY=raw/raw_transactions.csv
AWS_S3_CLEAN_PREFIX=processed/

# AWS RDS / Cloud Database Configuration
# Engine Options: postgresql / mysql / sqlite
DB_ENGINE=mysql
DB_HOST=your-rds-endpoint.czxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=assignment2_db
DB_USER=admin
DB_PASSWORD=YourSecurePassword123!

# PySpark Local and Execution Settings
SPARK_APP_NAME=SparkCloudETLPipeline
SPARK_MASTER=local[*]
