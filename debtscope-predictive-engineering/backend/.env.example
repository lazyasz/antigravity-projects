# Environment Settings
PROJECT_NAME="Predictive Engineering Intelligence Platform"
PROJECT_DESCRIPTION="Business-aware Decision Intelligence API for Technical Debt Prioritization"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default for MVP, PostgreSQL ready)
DATABASE_URL="sqlite:///./tech_debt_intelligence.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/techdebt_db"

# Security & CORS
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Priority Engine Component Weights
WEIGHT_TECHNICAL_RISK=0.35
WEIGHT_BUSINESS_IMPACT=0.30
WEIGHT_RELEASE_URGENCY=0.15
WEIGHT_MAINTENANCE_COST=0.10
WEIGHT_DEBT_AGE=0.10
WEIGHT_REMEDIATION_EFFORT=0.15
