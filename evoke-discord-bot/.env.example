# ============================================================
# EVOKE ESPORTS DISCORD BOT - ENVIRONMENT CONFIGURATION
# ============================================================

# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord Game Role IDs (assigned automatically upon registration)
BGMI_ROLE_ID=
VALORANT_ROLE_ID=
EAFC_ROLE_ID=

# Common & Staff Role IDs (Optional)
COMPETITIVE_ROLE_ID=
CASUAL_ROLE_ID=
STAFF_ROLE_ID=
ADMIN_ROLE_ID=
VERIFIED_ROLE_ID=

# Discord Channel IDs
REGISTRATION_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
LOG_CHANNEL_ID=
SM_POSTS_CHANNEL_ID=
SHARE_BOOST_CHANNEL_ID=
FEEDBACK_LOG_CHANNEL_ID=   # Optional: private staff channel to receive feedback; falls back to LOG_CHANNEL_ID

# Age Configuration (Optional - Defaults to 12 - 99)
MIN_PLAYER_AGE=12
MAX_PLAYER_AGE=99

# Backend Website API Integration Layer
# Leave blank until the Evoke website/API is provided by the web developer
EVOKE_API_URL=
EVOKE_API_KEY=
EVOKE_WEBSITE_URL=

# Development / Testing Mode
# When true, the bot simulates backend registration & duplicate checks with local storage
MOCK_API=true

# Node Environment
NODE_ENV=development
