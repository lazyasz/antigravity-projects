{
  "name": "evoke-discord-bot",
  "version": "1.0.0",
  "description": "Official Discord automation and community management bot for Evoke Esports",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
