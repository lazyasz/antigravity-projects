# ==============================================================================
# AWS & Amazon S3 Configuration
# ==============================================================================
AWS_REGION=eu-north-1
S3_BUCKET=cde-lab1-dhruv-upload-bucket
S3_FILE_KEY=upload_csv2.csv

# Optional AWS Credentials override (if not using ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ==============================================================================
# Amazon RDS MySQL Database Configuration
# ==============================================================================
RDS_HOST=your-rds-endpoint.c123456789.eu-north-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=etl_database
RDS_USERNAME=admin
RDS_PASSWORD=your_secure_password

# ==============================================================================
# Spark JDBC Configuration
# ==============================================================================
JDBC_JAR_PATH=drivers/mysql-connector-j-8.3.0.jar
